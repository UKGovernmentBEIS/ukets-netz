<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
		logicalFilePath="feedback_ddl.xml"
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.11.xsd">

	<changeSet id="0_1_0_create_feedback_table" author="P44065">
		<createSequence sequenceName="feedback_seq"/>
		<createTable tableName="feedback">
			<column name="id" type="bigint">
				<constraints primaryKey="true" primaryKeyName="feedback_pk" nullable="false"/>
			</column>
			<column name="payload" type="jsonb">
				<constraints nullable="false"/>
			</column>
			<column name="submitter_id" type="varchar(512)">
				<constraints nullable="false"/>
			</column>
			<column name="submission_date" type="timestamp">
				<constraints nullable="false"/>
			</column>
		</createTable>
		<rollback>
			<sql>
				DROP TABLE IF EXISTS feedback CASCADE;
				DROP SEQUENCE IF EXISTS feedback_seq;
			</sql>
		</rollback>
	</changeSet>
</databaseChangeLog>
